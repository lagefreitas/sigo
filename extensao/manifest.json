{
  "manifest_version": 3,
  "name": "Sigo — processos do SIPAC",
  "short_name": "Sigo",
  "version": "0.1.1",
  "description": "Consulte e acompanhe processos do SIPAC/UFAL de forma simples, com resumo opcional por IA usando a sua própria chave.",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://sipac.sig.ufal.br/*"
  ],
  "optional_host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://api.anthropic.com/*",
    "https://api.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Abrir o Sigo",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "side_panel": {
    "default_path": "painel.html"
  },
  "options_page": "opcoes.html",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}